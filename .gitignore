/.phpunit.cache
/node_modules
# public/build is committed on purpose: the production host has no Node, so
# `npm run build` cannot run there. Rebuild locally and commit the output.
# /public/build
/public/hot
/public/storage
/storage/*.key
/vendor

# Local SQLite databases (development/verification only).
/database/*.sqlite
/database/*.sqlite-journal
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode

# Uploaded candidate documents contain personal data (passport details, photos)
# and must never reach the repository. Demo placeholder images stay tracked.
/storage/app/public/candidates/cvs/
/storage/app/public/candidates/videos/
/public/*.pdf

# Raw artwork drops; the working copy lives in storage/app/public/site/.
/public/images/ChatGPT Image*
